  "item": [
    {
      "name": "Registrar Ana",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/register",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana\",\n  \"email\": \"ana.{{run_id}}@example.com\",\n  \"password\": \"password123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('run_id', Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token_ana', pm.response.json().token);",
              "pm.collectionVariables.set('user_ana', pm.response.json().user.id);"
            ]
          }
        }
      ]
    },
